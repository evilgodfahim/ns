version: '3.8'

# Override file for development
# This file is automatically used by docker-compose alongside docker-compose.yml

services:
  flaresolverr:
    environment:
      - LOG_LEVEL=debug  # More verbose logging for development
      - LOG_HTML=true    # Log full HTML responses (helpful for debugging)
    
  scraper:
    # Override command to keep container running for debugging
    command: tail -f /dev/null
    # Uncomment to auto-restart on code changes
    # volumes:
    #   - ./scraper.py:/app/scraper.py:ro
    
  nginx:
    # Expose nginx logs
    volumes:
      - ./feed.xml:/usr/share/nginx/html/feed.xml:ro
      - ./index.html:/usr/share/nginx/html/index.html:ro
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - nginx-logs:/var/log/nginx

volumes:
  nginx-logs:
